# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-access-key
AZURE_BLOB_CONTAINER_NAME=medias
AZURE_UPLOAD_FOLDER=pdf

# YouTube Catalog Configuration
YOUTUBE_CATALOG_BLOB=meta/catalog.youtube.json

# CORS Configuration (comma-separated list of allowed origins for static player)
# Example: https://your-static-site.z6.web.core.windows.net,https://another-domain.com
ALLOWED_ORIGIN=

# Server Configuration
PORT=3000
NODE_ENV=development